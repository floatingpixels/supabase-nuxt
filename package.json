{
  "name": "@floatingpixels/supabase-nuxt",
  "version": "0.6.3",
  "description": "Supabase module for Nuxt",
  "repository": "floatingpixels/supabase-nuxt",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "release-it": {
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "preRelease": false,
      "draft": false,
      "tokenRef": "GITHUB_TOKEN"
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run prepack && release-it",
    "lint": "eslint .",
    "test": "nuxi prepare playground && pnpm exec tsc --noEmit --pretty false && pnpm vitest",
    "test:unit": "nuxi prepare playground && pnpm exec tsc --noEmit --pretty false && vitest run --project=unit",
    "test:nuxt": "nuxi prepare playground && vitest run --project=nuxt",
    "test:watch": "vitest watch",
    "test:pw": "playwright test test/playwright/",
    "test:e2e": "bash scripts/e2e.sh",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "db:fullreset": "pnpm run --silent db:reset && pnpm run --silent db:types && pnpm run --silent db:sync && pnpm run --silent db:seed",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types --lang=typescript --local > ./playground/types/supabase.d.ts",
    "db:lint": "sqlfluff lint --dialect postgres ./supabase/migrations/*.sql",
    "db:format": "sqlfluff format --dialect postgres ./supabase/migrations/*.sql",
    "db:reset": "supabase db reset",
    "db:seed": "npx tsx seed.ts",
    "db:sync": "npx @snaplet/seed sync",
    "db:fullseed": "(npx @snaplet/seed sync) -and (npx tsx seed.ts)",
    "db:dump": "pg_dump -a -h localhost -U postgres -p 54322 -f ./supabase/seed.sql --schema=public --schema=auth --inserts",
    "cleanup": "pnpm nuxi cleanup && rm -rf node_modules pnpm-lock.yaml && pnpm i"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-alpha.7",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "^1.62.0",
    "@snaplet/copycat": "^6.0.0",
    "@snaplet/seed": "^0.98.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "h3": "^1.15.11",
    "happy-dom": "^20.11.1",
    "nuxt": "^4.5.1",
    "playwright-core": "^1.62.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "release-it": "^21.0.0",
    "std-env": "^4.2.0",
    "supabase": "^2.110.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
